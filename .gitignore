# ============================================
# Unity プロジェクト用 ignore
# ============================================

# Unity の自動生成フォルダ（unity/ 配下のすべてのプロジェクトに適用）
unity/**/[Ll]ibrary/
unity/**/[Tt]emp/
unity/**/[Oo]bj/
unity/**/[Bb]uild/
unity/**/[Bb]uilds/
unity/**/[Ll]ogs/
unity/**/[Uu]ser[Ss]ettings/
unity/**/[Mm]emoryCaptures/
unity/**/[Rr]ecordings/


# Visual Studio cache
unity/**/.vs/

# Gradle cache
unity/**/.gradle/

# Auto-generated solution/project files
unity/**/*.csproj
unity/**/*.unityproj
unity/**/*.sln
unity/**/*.suo
unity/**/*.tmp
unity/**/*.user
unity/**/*.userprefs
unity/**/*.pidb
unity/**/*.booproj
unity/**/*.svd
unity/**/*.pdb
unity/**/*.mdb
unity/**/*.opendb
unity/**/*.VC.db

# Unity meta files
unity/**/*.pidb.meta
unity/**/*.pdb.meta
unity/**/*.mdb.meta

# Crash reports
unity/**/sysinfo.txt

# Unity Builds
unity/**/*.apk
unity/**/*.aab
unity/**/*.unitypackage
unity/**/*.app

# Crashlytics
unity/**/crashlytics-build.properties

# Packed Addressables
unity/**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Auto-generated Android Assets
unity/**/[Aa]ssets/[Ss]treamingAssets/aa.meta
unity/**/[Aa]ssets/[Ss]treamingAssets/aa/*

# ============================================
# flutter_embed_unity が生成する unityLibrary
# ============================================

# Android: Unity Export で生成される、各自再生成するべきフォルダ
android/unityLibrary/
android/.gradle/

# iOS: 同じく Unity Export 後に生成される
ios/UnityFramework/
ios/UnityLibrary/

# Unity Export の生成ログ
unity/**/*Build*.log